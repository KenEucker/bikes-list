# =============================================================================
# Bikeslist Application - Environment Example
# =============================================================================
# Copy this file to .env (or laravel/.env when using Docker) and set values.
# For Docker: The app reads laravel/.env. If a root .env exists, the entrypoint
# merges it by replacing/overriding matching keys (root takes precedence; no append).
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=Bikeslist
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Runtime mode: "consumer" (default) or "admin" (loads Orchid admin)
APP_RUNTIME=consumer

# Optional: base domain for the app (e.g. bikeslist.example.com). Used for
# session cookie domain in local when SESSION_DRIVER=database.
APP_DOMAIN=

# Maintenance
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database
APP_PREVIOUS_KEYS=

# -----------------------------------------------------------------------------
# Database (PostgreSQL used by default in this project)
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=laravel
# Or use a single URL instead of host/port/database/user/password:
# DB_URL=postgres://user:password@host:5432/database

# Optional (when not using DB_URL)
DB_CHARSET=utf8
DB_SSLMODE=prefer
DB_SOCKET=
DB_FOREIGN_KEYS=true

# MySQL (if switching from pgsql)
# DB_CONNECTION=mysql
# DB_PORT=3306
# DB_COLLATION=utf8mb4_unicode_ci
# MYSQL_ATTR_SSL_CA=

# -----------------------------------------------------------------------------
# Redis (optional; for cache, queue, sessions)
# -----------------------------------------------------------------------------
REDIS_CLIENT=predis
REDIS_CLUSTER=redis
REDIS_PREFIX=
REDIS_PERSISTENT=false
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default
REDIS_MAX_RETRIES=3
REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
REDIS_BACKOFF_BASE=100
REDIS_BACKOFF_CAP=1000

# -----------------------------------------------------------------------------
# Cache
# -----------------------------------------------------------------------------
CACHE_STORE=file
CACHE_DRIVER=file
CACHE_PREFIX=
# When using database cache
DB_CACHE_CONNECTION=
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_CONNECTION=
DB_CACHE_LOCK_TABLE=cache_locks

# -----------------------------------------------------------------------------
# Queue
# -----------------------------------------------------------------------------
QUEUE_CONNECTION=sync
# For database queue
DB_QUEUE_CONNECTION=
DB_QUEUE_TABLE=jobs
DB_QUEUE_QUEUE=default
DB_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids

# -----------------------------------------------------------------------------
# Session
# -----------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_CONNECTION=
SESSION_TABLE=sessions
SESSION_STORE=
SESSION_COOKIE=
SESSION_PATH=/
# Cookie domain (e.g. .localhost for Docker; leave empty for default)
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true
SESSION_PARTITIONED_COOKIE=false

# -----------------------------------------------------------------------------
# Search (Scout / Meilisearch)
# -----------------------------------------------------------------------------
SCOUT_DRIVER=meilisearch
SCOUT_PREFIX=
SCOUT_QUEUE=false
SCOUT_IDENTIFY=false

MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=

# Optional: Algolia
# SCOUT_DRIVER=algolia
# ALGOLIA_APP_ID=
# ALGOLIA_SECRET=

# Optional: Typesense
# SCOUT_DRIVER=typesense
# TYPESENSE_API_KEY=xyz
# TYPESENSE_HOST=localhost
# TYPESENSE_PORT=8108
# TYPESENSE_PATH=
# TYPESENSE_PROTOCOL=http
# TYPESENSE_CONNECTION_TIMEOUT_SECONDS=2
# TYPESENSE_HEALTHCHECK_INTERVAL_SECONDS=30
# TYPESENSE_NUM_RETRIES=3
# TYPESENSE_RETRY_INTERVAL_SECONDS=1
# TYPESENSE_IMPORT_ACTION=upsert

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="Bikeslist"
MAIL_EHLO_DOMAIN=
MAIL_LOG_CHANNEL=
MAIL_SCHEME=
MAIL_URL=
MAIL_SENDMAIL_PATH=/usr/sbin/sendmail -bs -i

# Reply relay domain for listing reply addresses (defaults from APP_URL)
MAIL_RELAY_DOMAIN=

# Postmark / Resend / SES (when not using log/smtp)
# MAIL_MAILER=postmark
# POSTMARK_API_KEY=
# MAIL_MAILER=resend
# RESEND_API_KEY=

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
AUTH_GUARD=web
AUTH_PASSWORD_BROKER=users
AUTH_PASSWORD_RESET_USERS_TABLE=password_reset_tokens
AUTH_PASSWORD_RESET_ADMINS_TABLE=password_reset_tokens
AUTH_PASSWORD_TIMEOUT=10800
# Laravel subfolder (laravel/config) only:
# AUTH_PASSWORD_RESET_TOKEN_TABLE=password_reset_tokens
# AUTH_MODEL=App\Models\User

# -----------------------------------------------------------------------------
# Admin (Orchid) – used when APP_RUNTIME=admin or in laravel/
# -----------------------------------------------------------------------------
PLATFORM_PREFIX=/admin
PLATFORM_DOMAIN=
PLATFORM_FILESYSTEM_DISK=public

# -----------------------------------------------------------------------------
# Bikeslist-specific (laravel/config/bikeslist.php)
# -----------------------------------------------------------------------------
BIKESLIST_AUTO_PUBLISH_HOURS=48
BIKESLIST_AUTO_APPROVE_HOURS=48
BIKESLIST_BIKE_INDEX_URL=https://bikeindex.org/search
BIKESLIST_MODERATOR_RELAY_EMAIL=

# -----------------------------------------------------------------------------
# Filesystem
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=local

# AWS / S3 (e.g. for public uploads or Spaces)
# FILESYSTEM_DISK=spaces
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false
LOG_DAILY_DAYS=14
LOG_STDERR_FORMATTER=
LOG_SYSLOG_FACILITY=LOG_USER

# Slack
# LOG_CHANNEL=slack
# LOG_SLACK_WEBHOOK_URL=
# LOG_SLACK_USERNAME="Laravel Log"
# LOG_SLACK_EMOJI=:boom:

# Papertrail
# LOG_CHANNEL=papertrail
# PAPERTRAIL_URL=
# PAPERTRAIL_PORT=

# -----------------------------------------------------------------------------
# Docker / runtime (used by docker-compose and entrypoint)
# -----------------------------------------------------------------------------
# Set to false to skip migrations and seeding on container start
RUN_MIGRATIONS=true

# Set to 1 in app container to run Vite in watch mode (e.g. VITE_WATCH=1)
VITE_WATCH=0

# -----------------------------------------------------------------------------
# Third-party / optional
# -----------------------------------------------------------------------------
# Slack notifications (laravel config)
# SLACK_BOT_USER_OAUTH_TOKEN=
# SLACK_BOT_USER_DEFAULT_CHANNEL=

# DynamoDB cache (if used)
# DYNAMODB_CACHE_TABLE=cache
# DYNAMODB_ENDPOINT=

# Memcached (if used)
# MEMCACHED_PERSISTENT_ID=
# MEMCACHED_USERNAME=
# MEMCACHED_PASSWORD=
# MEMCACHED_HOST=127.0.0.1
# MEMCACHED_PORT=11211

# SQS queue
# SQS_PREFIX=https://sqs.us-east-1.amazonaws.com/your-account-id
# SQS_QUEUE=default
# SQS_SUFFIX=

# Beanstalkd queue
# BEANSTALKD_QUEUE_HOST=localhost
# BEANSTALKD_QUEUE=default
# BEANSTALKD_QUEUE_RETRY_AFTER=90
# ---------------------------------------------------------------------------
# BikesList Uploads – copy these into laravel/.env (see bikeslist-uploads.spec.md)
# ---------------------------------------------------------------------------

# ----- MinIO (development, Docker) -----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

UPLOADS_DRIVER=s3
UPLOADS_BUCKET=uploads
UPLOADS_REGION=us-east-1
UPLOADS_KEY=minioadmin
UPLOADS_SECRET=minioadmin
UPLOADS_ENDPOINT=http://minio:9000
UPLOADS_URL=/uploads
UPLOADS_PATH_STYLE=true
UPLOADS_VISIBILITY=public
UPLOADS_PREFIX=uploads
UPLOADS_PROCESS_SYNC=false

# ----- DigitalOcean Spaces (production) -----
# MINIO_* not used in prod
# UPLOADS_DRIVER=s3
# UPLOADS_BUCKET=your-space-name
# UPLOADS_REGION=nyc3
# UPLOADS_KEY=your-spaces-key
# UPLOADS_SECRET=your-spaces-secret
# UPLOADS_ENDPOINT=https://nyc3.digitaloceanspaces.com
# UPLOADS_URL=https://your-space-name.nyc3.digitaloceanspaces.com
# UPLOADS_PATH_STYLE=false
# UPLOADS_VISIBILITY=public
# UPLOADS_PREFIX=uploads

# Social Login (Google & Discord OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=/auth/google/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=/auth/discord/callback