{
  "name": "bikes-list",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run -ws dev",
    "dev:up": "docker compose -f docker-compose.dev.yml up --build",
    "dev:up-d": "docker compose -f docker-compose.dev.yml up --build -d",
    "dev:down": "docker compose -f docker-compose.dev.yml down",
    "dev:down-v": "docker compose -f docker-compose.dev.yml down -v",
    "dev:logs": "docker compose -f docker-compose.dev.yml logs -f --tail=200",
    "dev:logs:api": "docker compose -f docker-compose.dev.yml logs -f --tail=200 api",
    "dev:logs:web": "docker compose -f docker-compose.dev.yml logs -f --tail=200 web",
    "dev:logs:admin": "docker compose -f docker-compose.dev.yml logs -f --tail=200 admin",
    "dev:logs:db": "docker compose -f docker-compose.dev.yml logs -f --tail=200 db",
    "dev:logs:mail": "docker compose -f docker-compose.dev.yml logs -f --tail=200 mailhog",
    "build": "npm run -ws build",
    "start": "npm run -ws start",
    "dev:seed": "docker compose exec api npm run -w apps/api migrate:deploy && docker compose exec api npm run -w apps/api seed"
  },
  "devDependencies": {
    "tsx": "^4.7.0",
    "typescript": "^5.4.5"
  }
}
