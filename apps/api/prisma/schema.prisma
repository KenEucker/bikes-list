datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

enum Role {
  USER
  MAINTAINER
  AMBASSADOR
  ADMIN
  SUPER_ADMIN
}

enum Module {
  EVENTS
  SHOPS
  ORGS
  FORSALE
  IMAGES
  ADS
  DISCORD
}

enum AuthProvider {
  DISCORD
  GOOGLE
  MAGIC_LINK
}

enum MediaOwnerType {
  FOR_SALE
  EVENT
  SHOP
  ORG
  AD
  USER_AVATAR
}

enum MediaVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ModerationActionType {
  APPROVE
  REJECT
}

model City {
  id           String          @id @default(uuid()) @db.Uuid
  country_code String
  region       String?
  name         String
  slug         String          @unique
  timezone     String
  is_active    Boolean         @default(true)
  created_at   DateTime        @default(now())
  updated_at   DateTime        @updatedAt
  role_assignments RoleAssignment[]
  settings     SystemSetting[]
  media_objects MediaObject[]
  moderation_actions ModerationAction[]

  @@map("cities")
}

model User {
  id            String          @id @default(uuid()) @db.Uuid
  email         String          @unique
  display_name  String?
  avatar_url    String?
  discord_id    String?         @unique
  google_id     String?         @unique
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt
  last_login_at DateTime?
  sessions      Session[]
  role_assignments RoleAssignment[]
  media_uploads MediaObject[]   @relation("MediaUploader")
  moderation_actions ModerationAction[] @relation("ModerationActor")

  @@map("users")
}

model Session {
  id          String       @id @default(uuid()) @db.Uuid
  user_id     String       @db.Uuid
  user        User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token       String       @unique
  provider    AuthProvider
  created_at  DateTime     @default(now())
  expires_at  DateTime
  revoked_at  DateTime?
  last_used_at DateTime?
  ip_address  String?
  user_agent  String?

  @@index([user_id])
  @@map("sessions")
}

model RoleAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role       Role
  city_id    String?  @db.Uuid
  city       City?    @relation(fields: [city_id], references: [id], onDelete: Cascade)
  module     Module?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([user_id, role, city_id, module])
  @@map("role_assignments")
}

model SystemSetting {
  id         String   @id @default(uuid()) @db.Uuid
  key        String
  value      String
  city_id    String?  @db.Uuid
  city       City?    @relation(fields: [city_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([key, city_id])
  @@map("system_settings")
}

model MediaObject {
  id                  String                  @id @default(uuid()) @db.Uuid
  owner_type          MediaOwnerType
  owner_id            String
  city_id             String?                 @db.Uuid
  city                City?                   @relation(fields: [city_id], references: [id], onDelete: SetNull)
  uploader_user_id    String?                 @db.Uuid
  uploader_user       User?                   @relation("MediaUploader", fields: [uploader_user_id], references: [id], onDelete: SetNull)
  bucket              String
  key                 String
  content_type        String
  byte_size           Int
  width               Int?
  height              Int?
  sha256              String?
  verification_status MediaVerificationStatus @default(PENDING)
  rejection_reason    String?
  created_at          DateTime                @default(now())
  updated_at          DateTime                @updatedAt

  @@index([owner_type, owner_id])
  @@index([verification_status])
  @@map("media_objects")
}

model ModerationAction {
  id            String                @id @default(uuid()) @db.Uuid
  actor_user_id String                @db.Uuid
  actor_user    User                  @relation("ModerationActor", fields: [actor_user_id], references: [id], onDelete: Cascade)
  action_type   ModerationActionType
  entity_type   String
  entity_id     String
  city_id       String?               @db.Uuid
  city          City?                 @relation(fields: [city_id], references: [id], onDelete: SetNull)
  note          String?
  created_at    DateTime              @default(now())
  updated_at    DateTime              @updatedAt

  @@index([entity_type, entity_id])
  @@map("moderation_actions")
}
