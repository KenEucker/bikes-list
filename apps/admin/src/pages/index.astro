---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="BikesList Admin">
  <section class="flex flex-col gap-6">
    <p class="text-sm uppercase tracking-[0.25em] text-slate-400">Admin SSR</p>
    <h1 class="text-4xl font-semibold text-white sm:text-5xl">
      BikesList super-admin panel
    </h1>
    <p class="text-lg text-slate-300">
      This SSR admin shell is ready for future management tooling and shares the
      same Tailwind foundation as the public site.
    </p>
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-5">
        <h2 class="text-lg font-semibold text-white">Operations</h2>
        <p class="text-sm text-slate-300">
          Placeholder sections for upcoming dashboards.
        </p>
      </div>
      <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-5">
        <h2 class="text-lg font-semibold text-white">Configuration</h2>
        <p class="text-sm text-slate-300">
          Environment-ready settings and tools.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
