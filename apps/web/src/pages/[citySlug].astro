---
import BaseLayout from "../layouts/BaseLayout.astro";

const { citySlug } = Astro.params;
const apiBase = import.meta.env.PUBLIC_API_URL ?? "http://localhost:3001";

let city: {
  name: string;
  slug: string;
  is_active: boolean;
  timezone: string;
  country_code: string;
  region?: string | null;
} | null = null;

if (citySlug) {
  const response = await fetch(`${apiBase}/cities/${citySlug}`);
  if (response.ok) {
    const data = await response.json();
    city = data.city;
  }
}

const pageTitle = city ? `${city.name} | BikesList` : "City Not Found | BikesList";
---

<BaseLayout title={pageTitle}>
  <section class="flex flex-col gap-6">
    {city ? (
      <>
        <p class="text-sm uppercase tracking-[0.25em] text-slate-400">{city.slug}</p>
        <h1 class="text-4xl font-semibold text-white sm:text-5xl">{city.name}</h1>
        <p class="text-lg text-slate-300">
          {city.region ? `${city.region}, ` : ""}
          {city.country_code} · {city.timezone}
        </p>
        {city.is_active ? (
          <div class="rounded-2xl border border-emerald-500/30 bg-emerald-500/10 p-6 text-emerald-100">
            <h2 class="text-lg font-semibold">City listings are live</h2>
            <p class="text-sm text-emerald-100/80">
              This city is active. Listings and events will appear here in the next phase.
            </p>
          </div>
        ) : (
          <div class="rounded-2xl border border-amber-500/30 bg-amber-500/10 p-6 text-amber-100">
            <h2 class="text-lg font-semibold">Coming Soon</h2>
            <p class="text-sm text-amber-100/80">
              We are onboarding this city. Check back soon for listings.
            </p>
          </div>
        )}
      </>
    ) : (
      <div class="rounded-2xl border border-rose-500/30 bg-rose-500/10 p-6 text-rose-100">
        <h1 class="text-lg font-semibold">City Not Found</h1>
        <p class="text-sm text-rose-100/80">
          We could not locate a city with that slug.
        </p>
      </div>
    )}
  </section>
</BaseLayout>
