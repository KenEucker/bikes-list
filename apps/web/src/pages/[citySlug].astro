---
import BaseLayout from "../layouts/BaseLayout.astro";
import Badge from "@bikes-list/webcore-ui/Badge";
import Card from "@bikes-list/webcore-ui/Card";

const { citySlug } = Astro.params;
const apiBase = import.meta.env.PUBLIC_API_URL ?? "http://localhost:3001";

let city: {
  name: string;
  slug: string;
  is_active: boolean;
  timezone: string;
  country_code: string;
  region?: string | null;
} | null = null;

if (citySlug) {
  const response = await fetch(`${apiBase}/cities/${citySlug}`);
  if (response.ok) {
    const data = await response.json();
    city = data.city;
  }
}

const pageTitle = city ? `${city.name} | BikesList` : "City Not Found | BikesList";
---

<BaseLayout title={pageTitle}>
  <section class="flex flex-col gap-6">
    {city ? (
      <>
        <Badge tone="outline" size="sm">{city.slug}</Badge>
        <h1 class="text-4xl font-semibold text-[var(--text-primary)] sm:text-5xl">
          {city.name}
        </h1>
        <p class="text-lg text-[var(--text-secondary)]">
          {city.region ? `${city.region}, ` : ""}
          {city.country_code} · {city.timezone}
        </p>
        {city.is_active ? (
          <Card
            class="border-[var(--status-positive-border)] bg-[var(--status-positive-bg)] text-[var(--status-positive-text)]"
            padding="md"
          >
            <h2 class="text-lg font-semibold">City listings are live</h2>
            <p class="text-sm opacity-80">
              This city is active. Listings and events will appear here in the next phase.
            </p>
          </Card>
        ) : (
          <Card
            class="border-[var(--status-warning-border)] bg-[var(--status-warning-bg)] text-[var(--status-warning-text)]"
            padding="md"
          >
            <h2 class="text-lg font-semibold">Coming Soon</h2>
            <p class="text-sm opacity-80">
              We are onboarding this city. Check back soon for listings.
            </p>
          </Card>
        )}
      </>
    ) : (
      <Card
        class="border-[var(--status-danger-border)] bg-[var(--status-danger-bg)] text-[var(--status-danger-text)]"
        padding="md"
      >
        <h1 class="text-lg font-semibold">City Not Found</h1>
        <p class="text-sm opacity-80">We could not locate a city with that slug.</p>
      </Card>
    )}
  </section>
</BaseLayout>
