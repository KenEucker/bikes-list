---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="BikesList Signup">
  <section class="flex flex-col gap-6">
    <header class="flex flex-col gap-2">
      <p class="text-sm uppercase tracking-[0.25em] text-slate-400">Signup</p>
      <h1 class="text-4xl font-semibold text-white sm:text-5xl">Request access</h1>
      <p class="text-lg text-slate-300">
        BikesList accounts are currently created by admins. If you need access, reach out
        and we’ll set up your account.
      </p>
    </header>
    <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6">
      <p class="text-sm text-slate-300">
        Email: <a class="text-emerald-200 underline" href="mailto:hello@bikeslist.dev">hello@bikeslist.dev</a>
      </p>
    </div>
  </section>
</BaseLayout>
