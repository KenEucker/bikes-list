---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "@bikes-list/webcore-ui/Button";
import Card from "@bikes-list/webcore-ui/Card";
---

<BaseLayout title="BikesList Signup">
  <section class="flex flex-col gap-6">
    <header class="flex flex-col gap-2">
      <p class="text-xs uppercase tracking-[0.25em] text-[var(--text-muted)]">Signup</p>
      <h1 class="text-4xl font-semibold text-[var(--text-primary)] sm:text-5xl">
        Request access
      </h1>
      <p class="text-lg text-[var(--text-secondary)]">
        BikesList accounts are currently created by admins. If you need access, reach out and
        we’ll set up your account.
      </p>
    </header>
    <Card>
      <p class="text-sm text-[var(--text-secondary)]">
        Email:
        <Button
          class="ml-2 px-0 py-0 text-sm underline"
          href="mailto:hello@bikeslist.dev"
          variant="ghost"
          size="sm"
        >
          hello@bikeslist.dev
        </Button>
      </p>
    </Card>
  </section>
</BaseLayout>
