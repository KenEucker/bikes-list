---
import BaseLayout from "../layouts/BaseLayout.astro";
import Badge from "@bikes-list/webcore-ui/Badge";
import Button from "@bikes-list/webcore-ui/Button";
import Card from "@bikes-list/webcore-ui/Card";
import Input from "@bikes-list/webcore-ui/Input";

const apiBase = import.meta.env.PUBLIC_API_URL ?? "http://localhost:3001";
const cookieHeader = Astro.request.headers.get("cookie") ?? "";
const appOrigin = new URL(Astro.request.url).origin;
let cities: Array<{
  name: string;
  slug: string;
  is_active: boolean;
  country_code: string;
  region?: string | null;
}> = [];
let loadError = "";
let currentUser:
  | {
      id: string;
      email: string;
      display_name?: string | null;
    }
  | null = null;
let roles: Array<{
  role: string;
  city?: { name: string; slug: string } | null;
  module?: string | null;
}> = [];
let authError = "";

try {
  const response = await fetch(`${apiBase}/cities`);
  const data = response.ok ? await response.json() : { cities: [] };
  cities = data.cities ?? [];
} catch (error) {
  loadError = error instanceof Error ? error.message : "Unable to load cities.";
}

try {
  const response = await fetch(`${apiBase}/me`, {
    headers: {
      cookie: cookieHeader
    }
  });
  if (response.ok) {
    const data = await response.json();
    currentUser = data.user;
    roles = data.roles ?? [];
  }
} catch (error) {
  authError = error instanceof Error ? error.message : "Unable to load session.";
}
---

<BaseLayout title="BikesList">
  <section class="flex flex-col gap-8">
    <header class="flex flex-col gap-3">
      <p class="text-xs uppercase tracking-[0.25em] text-[var(--text-muted)]">Phase 1</p>
      <h1 class="text-4xl font-semibold text-[var(--text-primary)] sm:text-5xl">
        BikesList city directory
      </h1>
      <p class="text-lg text-[var(--text-secondary)]">
        Browse active and upcoming cities. Each city now has its own route and lifecycle state.
      </p>
    </header>

    <Card>
      <div class="flex flex-col gap-2">
        <h2 class="text-xl font-semibold text-[var(--text-primary)]">Account</h2>
        {authError ? (
          <p class="text-sm text-[var(--status-danger-text)]">Session error: {authError}</p>
        ) : currentUser ? (
          <div class="flex flex-col gap-3">
            <div>
              <p class="text-xs uppercase tracking-[0.2em] text-[var(--text-muted)]">Signed in</p>
              <p class="text-lg font-semibold text-[var(--text-primary)]">
                {currentUser.display_name ?? currentUser.email}
              </p>
              <p class="text-sm text-[var(--text-secondary)]">{currentUser.email}</p>
            </div>
            <div class="flex flex-wrap gap-2">
              {roles.length ? (
                roles.map((assignment) => (
                  <Badge tone="outline" size="sm">
                    {assignment.role}
                    {assignment.city ? ` · ${assignment.city.name}` : ""}
                    {assignment.module ? ` · ${assignment.module}` : ""}
                  </Badge>
                ))
              ) : (
                <span class="text-sm text-[var(--text-muted)]">No roles assigned yet.</span>
              )}
            </div>
            <Button
              class="logout-button w-fit"
              type="button"
              variant="outline"
              size="sm"
            >
              Log out
            </Button>
          </div>
        ) : (
          <div class="flex flex-col gap-4">
            <p class="text-sm text-[var(--text-secondary)]">
              Sign in to unlock role-aware experiences across BikesList.
            </p>
            <div class="flex flex-wrap gap-3">
              <Button
                href={`/api/auth/discord?redirect=${appOrigin}/`}
                variant="outline"
                size="sm"
              >
                Continue with Discord
              </Button>
              <Button
                href={`/api/auth/google?redirect=${appOrigin}/`}
                variant="outline"
                size="sm"
              >
                Continue with Google
              </Button>
            </div>
            <form class="magic-link-form flex flex-col gap-3">
              <Input
                name="email"
                placeholder="you@example.com"
                type="email"
                required
              />
              <Button type="submit" variant="primary" size="sm">
                Email me a magic link
              </Button>
              <p class="magic-link-status text-sm text-[var(--text-muted)]"></p>
            </form>
          </div>
        )}
      </div>
    </Card>

    <Card>
      <div class="flex items-center justify-between">
        <h2 class="text-xl font-semibold text-[var(--text-primary)]">Cities</h2>
        <span class="text-sm text-[var(--text-muted)]">{cities.length} total</span>
      </div>
      {loadError ? (
        <Card
          class="mt-4 border-[var(--status-danger-border)] bg-[var(--status-danger-bg)] text-[var(--status-danger-text)]"
          padding="sm"
        >
          Failed to load cities from the API. {loadError}
        </Card>
      ) : cities.length ? (
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          {cities.map((city) => (
            <a class="block" href={`/${city.slug}`}>
              <Card class="h-full transition hover:border-[var(--text-muted)]" padding="sm">
                <div class="flex items-center justify-between text-xs uppercase tracking-[0.2em] text-[var(--text-muted)]">
                  <span>{city.slug}</span>
                  <Badge tone={city.is_active ? "success" : "warning"} size="sm">
                    {city.is_active ? "Active" : "Coming Soon"}
                  </Badge>
                </div>
                <h3 class="mt-3 text-lg font-semibold text-[var(--text-primary)]">
                  {city.name}
                </h3>
                <p class="text-sm text-[var(--text-secondary)]">
                  {city.region ? `${city.region}, ` : ""}{city.country_code}
                </p>
              </Card>
            </a>
          ))}
        </div>
      ) : (
        <Card
          class="mt-4 text-sm text-[var(--text-muted)]"
          tone="subtle"
          padding="md"
        >
          No cities are available yet. Check back soon.
        </Card>
      )}
    </Card>
  </section>
</BaseLayout>

<script>
  const magicForm = document.querySelector(".magic-link-form");
  const status = document.querySelector(".magic-link-status");
  magicForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!(magicForm instanceof HTMLFormElement)) {
      return;
    }
    const formData = new FormData(magicForm);
    const payload = Object.fromEntries(formData.entries());
    payload.redirect = window.location.origin + "/";
    if (status instanceof HTMLElement) {
      status.textContent = "Sending magic link...";
    }
    const response = await fetch("/api/auth/magic-link", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify(payload)
    });
    if (status instanceof HTMLElement) {
      if (response.ok) {
        const data = await response.json();
        status.textContent = `Magic link ready. Open: ${data.link}`;
      } else if (response.status === 404) {
        const data = await response.json();
        const link = data.signup_url ?? "/signup";
        status.innerHTML = `No account found. <a class="underline" href="${link}">Sign up</a>.`;
      } else {
        status.textContent = "Failed to create magic link.";
      }
    }
  });

  const logoutButton = document.querySelector(".logout-button");
  logoutButton?.addEventListener("click", async () => {
    await fetch("/api/auth/logout", { method: "POST" });
    window.location.reload();
  });
</script>
