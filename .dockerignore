node_modules
vendor
.git
.gitignore
.env
.env.backup
.phpunit.result.cache

# Root-level storage/bootstrap exclusions
storage/*.key
storage/logs/*
!storage/logs/.gitkeep
storage/framework/cache/*
!storage/framework/cache/.gitkeep
storage/framework/sessions/*
!storage/framework/sessions/.gitkeep
storage/framework/views/*
!storage/framework/views/.gitkeep
bootstrap/cache/*
!bootstrap/cache/.gitkeep

# Same exclusions under laravel/ (the actual app directory)
laravel/storage/*.key
laravel/storage/logs/*
!laravel/storage/logs/.gitkeep
laravel/storage/framework/cache/*
!laravel/storage/framework/cache/.gitkeep
laravel/storage/framework/sessions/*
!laravel/storage/framework/sessions/.gitkeep
laravel/storage/framework/views/*
!laravel/storage/framework/views/.gitkeep
laravel/bootstrap/cache/*
!laravel/bootstrap/cache/.gitkeep
