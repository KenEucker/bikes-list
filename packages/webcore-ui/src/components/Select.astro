---
const { class: className, ...rest } = Astro.props;

const classes = [
  "w-full rounded-lg border border-[var(--border-color)] bg-[var(--surface-bg)] px-3 py-2 text-sm text-[var(--text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--focus-ring)]",
  className
]
  .filter(Boolean)
  .join(" ");
---

<select class={classes} {...rest}>
  <slot />
</select>
