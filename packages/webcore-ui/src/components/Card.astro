---
const { class: className, padding = "md", tone = "default", ...rest } = Astro.props;

const tones = {
  default: "border border-[var(--border-color)] bg-[var(--surface-bg)]",
  muted: "border border-[var(--border-color)] bg-[var(--surface-muted)]",
  subtle: "border border-dashed border-[var(--border-color)] bg-[var(--surface-subtle)]"
};

const paddingSizes = {
  sm: "p-4",
  md: "p-6",
  lg: "p-8"
};

const classes = [
  "rounded-2xl shadow-sm",
  tones[tone] ?? tones.default,
  paddingSizes[padding] ?? paddingSizes.md,
  className
]
  .filter(Boolean)
  .join(" ");
---

<div class={classes} {...rest}>
  <slot />
</div>
